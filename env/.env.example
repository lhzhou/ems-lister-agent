# ==========================================
# 中国邮政重点特快与调度系统 - 环境变量示例文件
# 请根据部署环境拷贝为 .env 或 .env.development / .env.production
# ==========================================

# 应用名称与版本
VITE_APP_TITLE="邮政重点快递查询系统"
VITE_APP_NAME="CHINA POST EXPRESS & LOGISTICS"
VITE_APP_VERSION="1.0.0"

# 默认基础请求接口路径 (公司端服务监听配置 server.corporation.address 为 8902)
VITE_API_BASE_URL="http://39.107.75.132:8902"

# 客户推送网关地址（密钥详情路由键拼完整 URL）
VITE_EMS_PUSH_BASE_URL="https://ems-api.hnjxwl.com"

# 本地开发服务器监听配置 (IP 与 端口)
VITE_HOST="0.0.0.0"
VITE_PORT=9081
VITE_STRICT_PORT=false
VITE_OPEN=false

# 统一调度客服热线
VITE_EMS_HOTLINE="11183"

# 全局请求默认超时时间 (毫秒)
VITE_API_TIMEOUT=15000

# 全局表单控件尺寸：small / middle / large（Input、Select、Password、TextArea、Button）
VITE_FORM_CONTROL_SIZE=large

# 运行模式
VITE_ENV="development"
VITE_ENABLE_MOCK="true"
