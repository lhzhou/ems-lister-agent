# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL for backend logistics & authentication API endpoints
VITE_API_BASE_URL="http://39.107.75.132:8902"

# VITE_HOST: Local server host address (0.0.0.0 for LAN access)
VITE_HOST="0.0.0.0"

# VITE_PORT: Local server port number
VITE_PORT=9081

# VITE_STRICT_PORT: Whether to strictly fail if port is occupied (true/false)
VITE_STRICT_PORT=false

# VITE_OPEN: Whether to open browser automatically on start (true/false)
VITE_OPEN=false

# VITE_ENV: Current environment mode (development, production, test)
VITE_ENV="development"

# VITE_APP_TITLE: Application title
VITE_APP_TITLE="邮政重点快递查询系统"

# VITE_API_TIMEOUT: Default request timeout in milliseconds
VITE_API_TIMEOUT=15000

# VITE_ENABLE_MOCK: Whether mock fallback is enabled
VITE_ENABLE_MOCK="true"


