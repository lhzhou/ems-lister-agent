{
  "name": "ems-corporation-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "test": "bun test",
    "prod": "pnpm build && NODE_ENV=production node dist/server.cjs",
    "dev:server": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "oxlint . --react-plugin --import-plugin --deny-warnings && tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "page:create": "bun scripts/page-create.ts"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nprogress": "^0.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.9.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nprogress": "^0.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.22.0",
    "oxlint": "^1.18.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "bun": "1.4.x"
  }
}
